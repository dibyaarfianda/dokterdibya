{
  "name": "dibyaklinik-backend",
  "version": "1.0.1",
  "description": "Backend API for Dibya Klinik",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "robot:melinda": "node scripts/melinda-queue-robot.js --location rsia_melinda",
    "robot:gambiran": "node scripts/melinda-queue-robot.js --location rsud_gambiran",
    "test": "jest --coverage --verbose",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPatterns=unit",
    "test:integration": "jest --testPathPatterns=integration",
    "test:ci": "jest --runInBand --coverage=false --testPathPatterns=unit",
    "test:staff-smoke": "jest --runInBand --coverage=false tests/unit/StaffPanelWave1Hardening.test.js tests/unit/StaffPanelWave2LazyShell.test.js tests/unit/StaffApiClient.test.js tests/integration/observabilityAuth.test.js",
    "check:staff-static": "node scripts/staff-static-check.js",
    "perf:budget": "node scripts/perf-budget-check.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.939.0",
    "@aws-sdk/s3-request-presigner": "^3.939.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "adm-zip": "^0.5.16",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "chartjs-node-canvas": "^5.0.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.3.0",
    "firebase-admin": "^13.6.0",
    "fuse.js": "^7.1.0",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.6.5",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.1",
    "openai": "^6.9.1",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.17.2",
    "puppeteer": "^24.34.0",
    "qrcode": "^1.5.4",
    "redis": "^5.9.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.10.4",
    "web-push": "^3.6.7",
    "winston": "^3.18.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "nodemon": "^3.0.2",
    "supertest": "^7.1.4"
  }
}
