# Server Configuration
PORT=3000
NODE_ENV=production

# Database Configuration
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=dibyaklinik

# JWT Configuration (REQUIRED - Generate a strong random secret)
JWT_SECRET=your_very_strong_secret_key_here_minimum_32_characters
JWT_EXPIRES_IN=7d
PATIENT_JWT_EXPIRES_IN=24h

# CORS Configuration
CORS_ORIGIN=https://praktekdrdibya.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Patient Intake Encryption
INTAKE_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY
INTAKE_ENCRYPTION_KEY_ID=v1

# Cloudflare R2 Storage (for medical files: lab results, USG, X-ray, etc.)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=dokterdibya-medis
R2_PUBLIC_URL=https://your-bucket.r2.dev

# WhatsApp Integration (Tanya Dokter)
# Enable automatic WhatsApp notification for new Tanya Dokter questions
TANYA_WA_NOTIFY_ENABLED=false
# Doctor WhatsApp number (Indonesia format, e.g. 08123456789)
TANYA_WA_DOCTOR_PHONE=
# Optional fallback doctor user id (new_id) for inbound webhook reply mapping
TANYA_WA_DOCTOR_USER_ID=
# Shared secret for webhook security (send in header x-tanya-wa-secret)
TANYA_WA_WEBHOOK_SECRET=
# Staff panel URL included in WhatsApp notification message
STAFF_PANEL_URL=https://dokterdibya.com/staff/public/index-adminlte.html

# WhatsApp auto provider priority: meta | fonnte
WA_PROVIDER=meta

# Meta WhatsApp Cloud API (official WhatsApp Business)
WHATSAPP_CLOUD_ENABLED=false
WHATSAPP_CLOUD_API_VERSION=v21.0
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_ACCESS_TOKEN=

# Fonnte configuration (optional fallback for automatic send)
FONNTE_ENABLED=false
FONNTE_TOKEN=
