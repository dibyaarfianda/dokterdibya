# Redirect HTTP and www to the apex domain.
server {
    listen 80;
    listen [::]:80;
    server_name sisiwanita.id www.sisiwanita.id;

    root /var/www/dokterdibya/public;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/dokterdibya/public;
        default_type "text/plain";
    }

    location / {
        return 301 https://sisiwanita.id$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.sisiwanita.id;

    # ssl_certificate /etc/letsencrypt/live/sisiwanita.id/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/sisiwanita.id/privkey.pem;

    return 301 https://sisiwanita.id$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name sisiwanita.id;

    root /var/www/dokterdibya/public;

    # ssl_certificate /etc/letsencrypt/live/sisiwanita.id/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/sisiwanita.id/privkey.pem;

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/dokterdibya/public;
        default_type "text/plain";
    }

    # Root landing page
    location = / {
        try_files /sisiwanita/index.html =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location = /index.html {
        try_files /sisiwanita/index.html =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location = /sisiwanita/index.html {
        try_files /sisiwanita/index.html =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    # Patient API stays same-origin on sisiwanita.id and is proxied to the existing Node backend.
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
    }

    # Socket.IO polling for patient-facing realtime features.
    location ^~ /socket.io/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Staff/Admin stay exclusively on dokterdibya.com.
    location ^~ /staff/ {
        return 404;
    }

    # Canonical PWA files
    location = /patient-portal.webmanifest {
        try_files /patient-portal.webmanifest =404;
        default_type application/manifest+json;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location = /sw.js {
        try_files /sw.js =404;
        default_type application/javascript;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        add_header Service-Worker-Allowed "/" always;
    }

    # Compatibility aliases retained through at least 2026-08-30.
    location = /sisiwanita.webmanifest {
        try_files /sisiwanita.webmanifest =404;
        default_type application/manifest+json;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location = /sisiwanita-sw.js {
        try_files /sisiwanita-sw.js =404;
        default_type application/javascript;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
        add_header Service-Worker-Allowed "/" always;
    }

    location = /offline.html {
        try_files /offline.html =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    # Shared public assets that the landing and patient portal use
    location ^~ /images/ {
        try_files $uri =404;
        add_header Cache-Control "public, max-age=604800" always;
    }

    location ^~ /scripts/ {
        try_files $uri =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location ^~ /js/ {
        try_files $uri =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location ^~ /styles/ {
        try_files $uri =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }

    location ^~ /uploads/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Patient portal HTML pages are live on sisiwanita.id.
    location ~* \.html$ {
        try_files $uri =404;
        add_header Cache-Control "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" always;
        add_header Pragma "no-cache" always;
        add_header Expires "0" always;
    }
}
