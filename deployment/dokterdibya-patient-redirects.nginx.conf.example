location ~ ^/(album-usg|antrian|artikel-kesehatan|artikel|bantuan|booking-klinik|community-chat|community-profile|dokumen-medis|estimasi-biaya-kehamilan|feedback|fertility-calendar|hasil-lab|info-terbaru|jadwal-rs|jadwal-vitamin|kelas-persalinan|kick-counter|konfirmasi-hadir|my-corner-visit|notifikasi|perjalanan-ibu|pregnancy-tracker|profil|riwayat-kunjungan|subscription|subscription-success|tanya-dokter)\.html$ {
    return 301 https://sisiwanita.id/$1.html$is_args$args;
}

location ~ ^/(album-usg|antrian|artikel-kesehatan|artikel|bantuan|booking-klinik|community-chat|community-profile|dokumen-medis|estimasi-biaya-kehamilan|feedback|fertility-calendar|hasil-lab|info-terbaru|jadwal-rs|jadwal-vitamin|kelas-persalinan|kick-counter|konfirmasi-hadir|my-corner-visit|notifikasi|perjalanan-ibu|pregnancy-tracker|profil|riwayat-kunjungan|subscription|subscription-success|tanya-dokter)-trial\.html$ {
    return 301 https://sisiwanita.id/$1.html$is_args$args;
}

location ~ ^/(antrian-live|booking-klinik|gerakan-bayi|jadwal-vitamin|kalender-kesuburan|monitoring-kehamilan|perjalanan-ibu|ruang-membaca|tanya-dokter|update-terkini)-promo-mock\.html$ {
    return 301 https://sisiwanita.id/$is_args$args;
}
