[Unit]
Description=Encrypted Asisten DAF backup without message sources
After=mariadb.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/var/www/dokterdibya/staff/backend
ExecStart=/usr/bin/node /var/www/dokterdibya/staff/backend/scripts/assistant-daf-backup.js
UMask=0077
Nice=10
NoNewPrivileges=true
