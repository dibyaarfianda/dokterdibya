{
  "name": "dibya-staff-preview",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4175",
    "build": "node scripts/prepare-assets.mjs && vite build && node scripts/build-worker.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4175",
