    "lint": "eslint .",
    "verify:release": "node scripts/verify-release.mjs dist"
  },
  "dependencies": {
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@preact/preset-vite": "^2.9.4",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "vite": "^6.3.5"
  }
}
