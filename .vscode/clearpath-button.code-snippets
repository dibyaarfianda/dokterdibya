{
  "clearpath-button": {
    "prefix": "clearpath-button",
    "description": "Clearpath CTA button with left pinned dot, right fading dot, and delayed navigation",
    "body": [
      "<!-- HTML -->",
      "<a class=\"doc-cta-link\" href=\"/album-usg-trial.html\">",
      "  <span class=\"doc-cta-track\">",
      "    <span class=\"dot dot-left\"></span>",
      "    <span class=\"text\">Lihat Album USG</span>",
      "    <span class=\"dot dot-right\"></span>",
      "  </span>",
      "</a>",
      "",
      "/* CSS */",
      ".doc-cta-link {",
      "  position: relative;",
      "  display: inline-flex;",
      "  align-items: center;",
      "  overflow: hidden;",
      "  margin-top: 28px;",
      "  font-family: 'Inter', sans-serif;",
      "  font-size: 13px;",
      "  font-weight: 700;",
      "  color: #ffffff;",
      "  letter-spacing: 0.08em;",
      "  text-transform: uppercase;",
      "  text-decoration: none;",
      "  background: #7ea89f;",
      "  border: none;",
      "  border-radius: 999px;",
      "  padding: 11px 20px 11px 14px;",
      "  min-width: 220px;",
      "  box-shadow: 0 2px 10px rgba(126, 168, 159, 0.28);",
      "}",
      "",
      ".doc-cta-link .doc-cta-track {",
      "  position: relative;",
      "  display: flex;",
      "  align-items: center;",
      "  width: 100%;",
      "  transform: translateX(0);",
      "  will-change: transform;",
      "  transition: transform 0.56s cubic-bezier(0.22, 1, 0.36, 1);",
      "}",
      "",
      ".doc-cta-link .dot {",
      "  width: 8px;",
      "  height: 8px;",
      "  border-radius: 50%;",
      "  background: rgba(255, 255, 255, 0.88);",
      "  will-change: transform;",
      "  transition: transform 0.56s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.36s ease;",
      "}",
      "",
      ".doc-cta-link .dot-left {",
      "  position: absolute;",
      "  left: 0;",
      "  transform: translateX(-58px);",
      "  opacity: 0;",
      "}",
      "",
      ".doc-cta-link .dot-right {",
      "  transform: translateX(0);",
      "  opacity: 1;",
      "  margin-left: auto;",
      "}",
      "",
      ".doc-cta-link .text {",
      "  position: relative;",
      "  z-index: 1;",
      "  white-space: nowrap;",
      "  margin-left: 8px;",
      "}",
      "",
      ".doc-cta-link:is(:hover, :focus-visible, :active) .doc-cta-track,",
      ".doc-cta-link.is-animating .doc-cta-track {",
      "  transform: translateX(42px);",
      "}",
      "",
      ".doc-cta-link:is(:hover, :focus-visible, :active) .dot-left,",
      ".doc-cta-link.is-animating .dot-left {",
      "  transform: translateX(-42px);",
      "  opacity: 1;",
      "}",
      "",
      ".doc-cta-link:is(:hover, :focus-visible, :active) .dot-right,",
      ".doc-cta-link.is-animating .dot-right {",
      "  transform: translateX(18px);",
      "  opacity: 0;",
      "}",
      "",
      "// JS: delay navigation to show animation",
      "document.addEventListener('click', function(e) {",
      "  var link = e.target && e.target.closest ? e.target.closest('.doc-cta-link') : null;",
      "  if (!link) return;",
      "  if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;",
      "  if (link.target === '_blank') return;",
      "",
      "  var href = link.getAttribute('href');",
      "  if (!href || href.charAt(0) === '#' || href.indexOf('javascript:') === 0) return;",
      "",
      "  e.preventDefault();",
      "  e.stopImmediatePropagation();",
      "  if (link.dataset.animating === '1') return;",
      "",
      "  link.dataset.animating = '1';",
      "  link.classList.add('is-animating');",
      "  link.style.pointerEvents = 'none';",
      "",
      "  setTimeout(function() {",
      "    window.location.href = link.href || href;",
      "  }, 620);",
      "}, true);"
    ]
  }
}
